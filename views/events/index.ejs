<%- include('../partials/header') %>
<section class="hero">
  <h1>Find your next event</h1>
  <form method="get" action="/" class="search">
    <input type="search" name="q" placeholder="Search by name, venue or description" value="<%= q %>" aria-label="Search events">
    <button class="button">Search</button>
  </form>
</section>
<% if (featured.length) { %>
  <section class="featured-section" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="section-title">Featured</h2>
    <div class="grid">
      <% for (const e of featured) { %><%- include('../partials/event-card', { e }) %><% } %>
    </div>
  </section>
  <% if (events.length) { %><h2 class="section-title">All upcoming events</h2><% } %>
<% } %>
<% if (!events.length && !featured.length) { %>
  <p class="empty"><%= q ? `No events match “${q}”.` : 'No upcoming events yet — check back soon.' %></p>
<% } else if (events.length) { %>
  <div class="grid">
    <% for (const e of events) { %><%- include('../partials/event-card', { e }) %><% } %>
  </div>
<% } %>
<%- include('../partials/footer') %>
